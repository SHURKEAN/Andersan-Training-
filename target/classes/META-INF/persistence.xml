<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.1">
    <persistence-unit name="coworkingPU">
        <class>com.Workspace</class>
        <class>com.Reservation</class>

        <properties>
            <!-- JDBC -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/coworking_space"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="3425"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- Schema update (dev only) -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Pretty SQL in console -->
            <property name="hibernate.show_sql"  value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
